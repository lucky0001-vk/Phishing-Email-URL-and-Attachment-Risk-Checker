# SafeX Deployment Configuration
SAFEX_HOST=0.0.0.0
SAFEX_PORT=8000
SAFEX_ENVIRONMENT=production
SAFEX_LOG_LEVEL=info

# Engine Safety Limits
SAFEX_MAX_ATTACHMENT_SIZE_MB=25
SAFEX_MAX_ATTACHMENT_COUNT=10
SAFEX_MAX_ARCHIVE_DEPTH=2

# Security & CORS
SAFEX_ALLOWED_ORIGINS=*
SAFEX_RATE_LIMIT_PER_MINUTE=60
